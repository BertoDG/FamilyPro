# Copia este fichero a .env (no se sube al repo) o define las variables en Vercel.

# Conexión a Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Si no se define, la app usa Postgres embebido (PGlite) en data/pglite.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Zona horaria de la casa (en Vercel no se puede usar TZ).
APP_TZ=Europe/Madrid

# Nombre del primer usuario administrador (solo se usa al inicializar).
ADMIN_NAME=admin
