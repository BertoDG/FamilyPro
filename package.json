{
  "name": "familypro",
  "version": "0.1.0",
  "description": "Gestión del hogar: lista de la compra, calendario, gastos y más. Modular y con API para atajos de iPhone.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "cli": "node --env-file-if-exists=.env scripts/cli.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "express": "^5.1.0",
    "postgres": "^4.1.0"
  }
}
